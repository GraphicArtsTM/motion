extends RefCounted

# NoteTexts: дневник разведчика M.E.G., который спустился сюда раньше
# игрока и не вернулся. Записки разбросаны по чанкам (note_spawner.gd), но
# читаются всегда по порядку: первая найденная — первая страница. Так
# история складывается от «где я» к «он здесь», а между строк — правила
# выживания: что слышит хозяин, где прятаться, как его обмануть.

const NOTES: Array = [
	["ДЕНЬ 1", "Если ты это читаешь — ты тоже провалился. Не паникуй.\n\nПока лампы гудят, ты не один, и это хорошо. Плохо, когда гул обрывается и становится тихо."],
	["ДЕНЬ 3", "Здесь кто-то ходит. Тяжело, с паузами, как будто прислушивается.\n\nБег он слышит через три коридора. Пешком — через пару комнат. Пригнувшись, почти никак. Я теперь хожу пригнувшись."],
	["ДЕНЬ 6", "Свет его не любит. Когда лампы начинают трещать и гаснуть одна за другой — он рядом, даже если ты его ещё не видишь.\n\nФонарь тоже захлёбывается. Не трать время, чтобы его трясти. Уходи."],
	["ДЕНЬ 9", "Шкафы спасают. Но только если он не видел, куда ты полез, — и только если ты отдышался.\n\nПотеряв меня, он обходит шкафы. Встаёт у дверцы и слушает. Я влетел в шкаф после бега и не мог унять дыхание. До сих пор слышу, как он скребётся в дверцу."],
	["ДЕНЬ 12", "Банки. Пустые консервные банки. Брось подальше — звон громче шагов, и он идёт на звон, даже когда уже гонится за тобой.\n\nЭто купило мне жизнь дважды."],
	["ДЕНЬ 17", "Он иногда просто стоит в конце коридора и смотрит.\n\nНе подходит. Не дышит. Не смотри на него долго: свет гаснет, а когда загорается — его нет. И ты не знаешь, где он теперь."],
	["ДЕНЬ 23", "Сзади кто-то идёт со мной в ногу. Я останавливаюсь — он останавливается. Оборачиваюсь — никого.\n\nВ темноте громче. Я перестал оборачиваться. Не знаю, что хуже."],
	["ДЕНЬ 30", "Нашёл дверь. Настоящую, железную, с замком на щитке. Гудит низко, за несколько коридоров слышно.\n\nЩиток мёртвый. Нужно питание — три предохранителя. Они светятся зелёным и гудят. Но надписи на стенах говорят не верить зелёному свету."],
	["ДЕНЬ 41", "Камера ещё пишет. Если найдут запись — передайте в M.E.G.: Уровень 0 не пустой. У него есть хозяин.\n\nГде по полу вода, он слышит каждый шаг. Зато и я слышу его — плеск за два коридора. А если долго тихо — не радуйся. Он приходит проверить."],
	["ДЕНЬ ?", "Два предохранителя в щитке. Третий где-то дальше, я слышу его гул.\n\nИ слышу дыхание за стеной. Оно всё ближе. Если ты нашёл это — вставь третий и не оглядывайся. Я пойду. Если не вернусь —"],
]


static func count() -> int:
	return NOTES.size()


static func title(index: int) -> String:
	return String(NOTES[clampi(index, 0, NOTES.size() - 1)][0])


static func body(index: int) -> String:
	return String(NOTES[clampi(index, 0, NOTES.size() - 1)][1])
