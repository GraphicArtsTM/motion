+        /// <summary>«Вжух»: шум нарастает и уходит, полоса частот открывается и закрывается.</summary>
+        public static AudioClip Whoosh()
+        {
+            var d = Buffer(0.5f);
+            float lp = 0f, low = 0f;
+            for (int i = 0; i < d.Length; i++)
+            {
+                float k = i / (float)d.Length;
