{
  "lines": [
    {"id": "w1", "who": "news", "t": 0.6, "text": "…неизвестный в маске удержал автобус над рекой. Полиция ищет таинственного героя…", "hint": "ровно, как телеведущая из телевизора", "fx": "tv", "say": "…неизвестный в маске удержал автобус над рекой. Полиция ищет таинственного героя…"},
    {"id": "d1", "who": "ded", "t": 5.7, "text": "Тимур! Первый день после каникул — и ты опять опаздываешь?", "hint": "ворчливо, громко из кухни"},
    {"id": "t1", "who": "timur", "t": 10.85, "text": "Не опоздаю! Я теперь… быстрый.", "hint": "на бегу, с хитрой улыбкой"},
    {"id": "g1", "who": "diyor", "t": 19.8, "text": "Ты где был? Я тебе вчера двадцать раз звонил!", "hint": "обиженно, но по-дружески"},
    {"id": "t2", "who": "timur", "t": 22.62, "text": "Доставка… затянулась.", "hint": "уклончиво, переводя дыхание"},
    {"id": "g2", "who": "diyor", "t": 24.42, "text": "До полуночи? Ты видел новости? Какой-то тип в костюме держал автобус на мосту!", "hint": "восторженно, быстро"},
    {"id": "t3", "who": "timur", "t": 29.12, "text": "Да ну… наверное, монтаж.", "hint": "слишком спокойно, отводит взгляд"},
    {"id": "g3", "who": "diyor", "t": 31.36, "text": "Монтаж? Пол-Новограда снимало!", "hint": "возмущённо"},
    {"id": "u1", "who": "teacher", "t": 42.0, "text": "Итак. Какая сила нужна, чтобы удержать автобус весом десять тонн?", "hint": "учительница физики, строго, но с иронией"},
    {"id": "c1", "who": "crowd", "t": 47.28, "text": "Ха-ха-ха!", "hint": "класс смеётся"},
    {"id": "u2", "who": "teacher", "t": 53.07, "text": "Арсланов! Раз ты такой ловкий — к доске!", "hint": "строго"},
    {"id": "t4", "who": "timur", "t": 56.68, "text": "Я? Э-э… сто тысяч ньютонов… примерно.", "hint": "растерянно, потом уверенно", "say": "Я? Э-э… сто тысяч ньютонов… примерно."},
    {"id": "u3", "who": "teacher", "t": 59.84, "text": "Хм. Верно. Садись.", "hint": "удивлённо"},
    {"id": "g4", "who": "diyor", "t": 67.4, "text": "Ты что, за троих ешь?", "hint": "с удивлением глядя на поднос"},
    {"id": "t5", "who": "timur", "t": 68.9, "text": "Растущий организм.", "hint": "с набитым ртом"},
    {"id": "m1", "who": "marjon", "t": 70.98, "text": "Привет, мальчики! Слышали? Весь лицей только о нём и говорит.", "hint": "легко, весело, садится рядом"},
    {"id": "g5", "who": "diyor", "t": 76.07, "text": "Ему нужно имя. Нормальное, громкое.", "hint": "деловито"},
    {"id": "m2", "who": "marjon", "t": 78.59, "text": "Человек-молния. Он же появился в грозу.", "hint": "мечтательно"},
    {"id": "g6", "who": "diyor", "t": 82.05, "text": "Нет-нет. Паук-Новоград! Звучит как бренд. Футболки, кружки…", "hint": "с азартом бизнесмена"},
    {"id": "m3", "who": "marjon", "t": 86.08, "text": "Диёр, ты даже героя превращаешь в бизнес.", "hint": "насмешливо"},
    {"id": "g7", "who": "diyor", "t": 89.7, "text": "Это гены. Папа бы мной гордился.", "hint": "с гордостью и капелькой грусти"},
    {"id": "m4", "who": "marjon", "t": 92.04, "text": "А ты как думаешь, Тимур?", "hint": "с интересом, глядя прямо на него"},
    {"id": "t6", "who": "timur", "t": 94.65, "text": "Я?.. Я думаю… он просто держит обещания.", "hint": "смущённо, тихо, но искренне"},
    {"id": "m5", "who": "marjon", "t": 98.44, "text": "Красиво сказал.", "hint": "тепло"},
    {"id": "g8", "who": "diyor", "t": 99.96, "text": "Красиво. Но на футболку не влезет.", "hint": "с улыбкой"},
    {"id": "a1", "who": "azim", "t": 109.6, "text": "Гарриев! Где мои деньги? Проспорил — плати. Пять тысяч.", "hint": "нагло, громко, жуёт жвачку"},
    {"id": "g9", "who": "diyor", "t": 113.84, "text": "Азим, это был не спор, ты сам…", "hint": "неуверенно"},
    {"id": "a2", "who": "azim", "t": 115.81, "text": "Мне всё равно. Гони.", "hint": "угрожающе, тихо"},
    {"id": "t7", "who": "timur", "t": 118.34, "text": "Не давай ему, Диёр.", "hint": "спокойно, твёрдо"},
    {"id": "a3", "who": "azim", "t": 120.63, "text": "О-о, курьер заговорил! Ты кто такой вообще?", "hint": "насмешливо, поворачиваясь"},
    {"id": "t8", "who": "timur", "t": 124.01, "text": "Тот, кто обычно опаздывает. Но сегодня — вовремя.", "hint": "спокойно, глядя в глаза"},
    {"id": "a4", "who": "azim", "t": 129.41, "text": "Ну всё, ты попал!", "hint": "взбешённо, замахиваясь"},
    {"id": "c2", "who": "crowd", "t": 136.42, "text": "Ого-о-о!", "hint": "вздох всего коридора"},
    {"id": "m6", "who": "marjon", "t": 137.12, "text": "Тимур?..", "hint": "изумлённо, тихо"},
    {"id": "g10", "who": "diyor", "t": 137.93, "text": "Ты… как ты это сделал?!", "hint": "ошарашенно"},
    {"id": "t9", "who": "timur", "t": 139.32, "text": "Он… поскользнулся. Пол мокрый.", "hint": "неловко, показывая на табличку"},
    {"id": "a5", "who": "azim", "t": 141.88, "text": "Мама… я в космосе…", "hint": "в нокауте, слабо и смешно"},
    {"id": "n1", "who": "narrator", "t": 152.8, "text": "Драка — это было не самое страшное за день. Самое страшное ждало меня у подъезда.", "hint": "за кадром, с иронией"},
    {"id": "m7", "who": "marjon", "t": 162.2, "text": "Ой! Спасибо… Ты сегодня какой-то другой.", "hint": "удивлённо, потом мягко"},
    {"id": "t10", "who": "timur", "t": 165.69, "text": "Другой? Нет. Я тот же. Просто… пол был мокрый.", "hint": "смущённо"},
    {"id": "m8", "who": "marjon", "t": 169.66, "text": "Ты всегда так мало говоришь?", "hint": "со смехом"},
    {"id": "t11", "who": "timur", "t": 172.15, "text": "Только когда рядом человек, с которым… хочется говорить.", "hint": "тихо, глядя в сторону"},
    {"id": "m9", "who": "marjon", "t": 176.21, "text": "Это был комплимент?", "hint": "с улыбкой, прищурившись"},
    {"id": "t12", "who": "timur", "t": 177.96, "text": "Это была… неудачная попытка.", "hint": "почесав затылок"},
    {"id": "m10", "who": "marjon", "t": 180.39, "text": "Удачная.", "hint": "тепло, коротко"},
    {"id": "t13", "who": "timur", "t": 182.16, "text": "Слушай… а можно я буду звать тебя Эм-Джей?", "hint": "набравшись смелости", "say": "Слушай… а можно я буду звать тебя Эм Джей?"},
    {"id": "m11", "who": "marjon", "t": 185.14, "text": "Эм-Джей? Почему?", "hint": "удивлённо и заинтересованно", "say": "Эм Джей? Почему?"},
    {"id": "t14", "who": "timur", "t": 186.74, "text": "Мар-Жон. Эм… Джей. Звучит, как будто ты из комиксов.", "hint": "объясняет, улыбаясь", "say": "Мар Жон. Эм… Джей. Звучит, как будто ты из комиксов."},
    {"id": "m12", "who": "marjon", "t": 191.34, "text": "Ладно, курьер. Эм-Джей так Эм-Джей.", "hint": "игриво", "say": "Ладно, курьер. Эм Джей так Эм Джей."},
    {"id": "x1", "who": "mom", "t": 194.89, "text": "Маржон! Домой, ужин стынет!", "hint": "мама из окна, громко"},
    {"id": "m13", "who": "marjon", "t": 197.2, "text": "Иду, мам! …До завтра, Тимур.", "hint": "крикнув, потом тихо и тепло"},
    {"id": "t15", "who": "timur", "t": 200.76, "text": "До завтра… Эм-Джей.", "hint": "мечтательно, почти шёпотом", "say": "До завтра… Эм Джей."},
    {"id": "d2", "who": "ded", "t": 205.8, "text": "Ну что, как первый день?", "hint": "по-доброму"},
    {"id": "t16", "who": "timur", "t": 208.58, "text": "Нормально.", "hint": "мечтательно, с улыбкой"},
    {"id": "d3", "who": "ded", "t": 209.72, "text": "«Нормально» так не улыбаются.", "hint": "с хитрой усмешкой", "say": "Нормально так не улыбаются."},
    {"id": "t17", "who": "timur", "t": 212.14, "text": "Дед!", "hint": "смущённо"},
    {"id": "n2", "who": "narrator", "t": 213.41, "text": "Днём — школа, Диёр и Эм-Джей. Ночью — город. Я думал, это два разных мира…", "hint": "за кадром, задумчиво", "say": "Днём — школа, Диёр и Эм Джей. Ночью — город. Я думал, это два разных мира…"},
    {"id": "o1", "who": "odilman", "t": 227.6, "text": "Город любит героев. А кто ответит за его долги?", "hint": "низко, медленно, с горечью", "fx": "mask"},
    {"id": "o2", "who": "odilman", "t": 231.24, "text": "Я — ODILMAN. И все заплатят!", "hint": "громко, торжественно, угрожающе", "fx": "mask", "say": "Я — Одилмэн. И все заплатят!"}
  ]
}
