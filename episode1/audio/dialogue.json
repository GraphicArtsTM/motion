{
  "lines": [
    {"id": "n1", "who": "narrator", "t": 1.0, "text": "Говорят, герои рождаются. Это неправда."},
    {"id": "n2", "who": "narrator", "t": 5.6, "text": "Героями становятся. За одну ночь."},
    {"id": "n3", "who": "narrator", "t": 11.0, "text": "Моя ночь началась как обычно. С опоздания."},
    {"id": "d1", "who": "ded", "t": 26.2, "text": "Тимур! Ты опять опаздываешь? Я ухожу на последний рейс, ужин на плите!"},
    {"id": "t1", "who": "timur", "t": 33.2, "text": "Последний заказ, дед! Башня «Аркада». Десять минут!"},
    {"id": "d2", "who": "ded", "t": 38.2, "text": "Помни, внук. Обещал — держи."},
    {"id": "t2", "who": "timur", "t": 41.8, "text": "Держу, дед! Всегда держу!"},
    {"id": "v1", "who": "vera", "t": 48.8, "text": "Курьер? Наконец-то! Это катализатор для проекта «Арахна».", "say": "Курьер? Наконец-то! Это катализатор для проекта Арахна."},
    {"id": "t3", "who": "timur", "t": 53.6, "text": "Ого… Это что, пауки? Железные?"},
    {"id": "v2", "who": "vera", "t": 56.4, "text": "Наноботы. Они ткут нить прочнее стали. Только руками не трогай."},
    {"id": "k1", "who": "kronov", "t": 63.0, "text": "Доктор Лис. С этой минуты проект под моим контролем."},
    {"id": "v3", "who": "vera", "t": 67.2, "text": "Кронов?! Нет! Они не готовы. Это не оружие!"},
    {"id": "k2", "who": "kronov", "t": 71.6, "text": "Пока нет."},
    {"id": "t4", "who": "timur", "t": 77.8, "text": "А-а-а! Он меня укусил!"},
    {"id": "k3", "who": "kronov", "t": 80.4, "text": "Ядро у меня. Уходим!"},
    {"id": "t5", "who": "timur", "t": 85.6, "text": "Где я?.. Что со мной?"},
    {"id": "n4", "who": "narrator", "t": 90.4, "text": "В ту ночь мир стал медленным. Я слышал каждую каплю."},
    {"id": "t6", "who": "timur", "t": 97.8, "text": "Я… прилипаю к стене?!"},
    {"id": "t7", "who": "timur", "t": 102.4, "text": "Нет-нет-нет-нет-нет!"},
    {"id": "t8", "who": "timur", "t": 110.4, "text": "Ха-ха! Я лечу! Я ЛЕЧУ!", "say": "Ха-ха! Я лечу! Я лечу!"},
    {"id": "n5", "who": "narrator", "t": 118.6, "text": "А потом я увидел мост."},
    {"id": "t9", "who": "timur", "t": 129.4, "text": "Сорок второй… Это же автобус деда!"},
    {"id": "c1", "who": "crowd", "t": 125.0, "text": "Помогите!"},
    {"id": "t10", "who": "timur", "t": 133.6, "text": "Я же просто курьер… Я не смогу."},
    {"id": "d3", "who": "ded", "t": 136.6, "text": "Обещал — держи."},
    {"id": "t11", "who": "timur", "t": 139.4, "text": "Держу."},
    {"id": "k4", "who": "kronov", "t": 141.6, "text": "Мальчишка в пижаме? Ты не знаешь, с кем связался!"},
    {"id": "t12", "who": "timur", "t": 147.0, "text": "Курьерская доставка! Распишитесь!"},
    {"id": "k5", "who": "kronov", "t": 150.0, "text": "Р-раздавлю!", "say": "Раздавлю!"},
    {"id": "t13", "who": "timur", "t": 158.0, "text": "Держись, дед! Я держу!"},
    {"id": "t14", "who": "timur", "t": 163.6, "text": "Говорят, молния не бьёт дважды в одно место. Проверим?"},
    {"id": "k6", "who": "kronov", "t": 168.4, "text": "Нет!"},
    {"id": "d4", "who": "ded", "t": 176.4, "text": "Спасибо, сынок… Кто ты?"},
    {"id": "t15", "who": "timur", "t": 179.6, "text": "Курьер. Спешу на ужин."},
    {"id": "d5", "who": "ded", "t": 184.4, "text": "Опять опоздал."},
    {"id": "t16", "who": "timur", "t": 186.2, "text": "Опоздал. Но обещание сдержал."},
    {"id": "d6", "who": "ded", "t": 189.4, "text": "Ешь, курьер. Остыло всё."},
    {"id": "n6", "who": "narrator", "t": 195.6, "text": "Меня зовут Тимур. Днём я развожу заказы. А ночью… я держу этот город."},
    {"id": "s1", "who": "shadow", "t": 208.6, "text": "«Арахна-7» выбрала носителя. Найдите мальчика.", "say": "Арахна семь выбрала носителя. Найдите мальчика."}
  ]
}
