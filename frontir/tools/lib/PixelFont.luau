-- Кириллица, совпадающая по виду с латиницей.
local SAME: { [string]: string } = {
	["А"] = "A",
	["В"] = "B",
	["Е"] = "E",
	["К"] = "K",
	["М"] = "M",
	["Н"] = "H",
	["О"] = "O",
	["Р"] = "P",
	["С"] = "C",
	["Т"] = "T",
	["Х"] = "X",
}
for cyr, lat in SAME do
	G[cyr] = G[lat]
end

PixelFont.Glyphs = G

local LOWER = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
local UPPER = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"

-- Символ → глиф (строчные — как заглавные; нет глифа — «?»).
function PixelFont.glyph(ch: string): { string }
	local up = string.upper(ch)
	if G[up] ~= nil then
		return G[up]
	end
	local k = 0
	for _, c in utf8.codes(LOWER) do
		k += 1
		if utf8.char(c) == ch then
			local j = 0
			for _, u in utf8.codes(UPPER) do
				j += 1
				if j == k then
					return G[utf8.char(u)] or G["?"]
				end
			end
		end
	end
	return G[ch] or G["?"]
end

return table.freeze(PixelFont)
