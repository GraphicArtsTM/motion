{
	"name": "Frontir",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			}
		},
		"ServerStorage": {
			"Maps": {
				"$path": "maps"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": false
			}
		}
	},
	"globIgnorePaths": [
		"**/.gitkeep"
	]
}
