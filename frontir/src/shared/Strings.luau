	["handbook.hire.name"] = { ru = "Найм войск", en = "Hiring troops" },
	["handbook.hire.what"] = {
		ru = "Войска — общий запас державы: пехота, танки, артиллерия, ПВО. Найм идёт очередью по линиям; готовые встают в гарнизон.",
