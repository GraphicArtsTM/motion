--!strict
--[[
	TouchText — §15ё: текст для касания. Подсказки игры говорят о клавишах («Казармы (клавиша 2)», «технологии Y →»,
	«Дипломатия [T]»); на телефоне клавиатуры нет — strip убирает такие упоминания, остальной текст не трогает.
	Чистый модуль (тест TouchText.spec): новые шаблоны подсказок с клавишами — проверить там.
]]

local TouchText = {}

-- Порядок важен: сначала «(клавиша 1, нажмите …)» → «(нажмите …)», потом скобки целиком.
local RULES: { { string } } = {
	{ "%(клавиш%S+ [^,)]+, (%D)", "(%1" }, -- дальше слово, а не «0»
	{ "%(keys? [^,)]+, (%D)", "(%1" },
	{ "%s*%(клавиш%S+ [^)]*%)", "" },
	{ "%s*%(keys? [^)]*%)", "" },
	{ "технологии %u →", "технологии →" },
	{ "tech %u →", "tech →" },
	{ "%s*%(%u%)", "" }, -- «(Y)», «(T)»
	{ "%s*%[[%u%d][%w]*%]", "" }, -- «[T]», «[Tab]», «[1]»
	{ "%s*%[[%u%d][%w]* / [%u%d][%w]*%]", "" }, -- «[Q / E]»
	{ "%s*%(%u — [^)]*%)", "" }, -- «(N — карта)»
	{ "([%s:])%u — ", "%1" }, -- §15ъ «Нанимайте войска: Z — пехота» → «…: пехота» (буква-клавиша перед тире)
}

function TouchText.strip(text: string): string
	local out = text
	for _, rule in RULES do
		out = string.gsub(out, rule[1], rule[2])
	end
	return out
end

return table.freeze(TouchText)
